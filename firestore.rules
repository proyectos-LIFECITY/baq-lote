rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Cada usuario solo ve y modifica sus propias consultas
    match /users/{uid}/consultas/{consultaId} {
      allow read, delete: if request.auth != null && request.auth.uid == uid;
      allow create, update: if request.auth != null && request.auth.uid == uid
        && request.resource.data.nombre is string && request.resource.data.nombre.size() <= 140
        && request.resource.data.get('notas', '') is string && request.resource.data.get('notas', '').size() <= 2000
        && request.resource.data.resumen is map;

      match /detalle/{docId} {
        allow read, delete: if request.auth != null && request.auth.uid == uid;
        allow create, update: if request.auth != null && request.auth.uid == uid
          && docId == 'datos'
          && request.resource.data.json is string && request.resource.data.json.size() < 1000000;
      }
    }
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
